# Logs (large and constantly changing — they break the build cache)
*.log
*.log.*

# Telethon sessions (do not belong in the image, they come via the bind mount)
*.session
*.session-journal

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Runtime data (snapshots, videos)
data/

# Build files
Dockerfile
.dockerignore
.gitignore
